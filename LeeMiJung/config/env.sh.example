#!/bin/bash
# =============================================================
# Claude Agent 환경 설정 (예시 파일)
# 사용법:
#   cp config/env.sh.example config/env.sh
#   config/env.sh 의 값을 실제 값으로 채운 뒤 저장한다. (git 에 커밋되지 않음)
#
# 쉘 스크립트에서 source로 로드:
#   source "$PROJECT_DIR/config/env.sh"
#
# 변경이력:
#   2026-09-03  env.sh 예시 파일 최초 작성 (실제 토큰은 git 에서 제외)
# =============================================================

# Telegram Bot 토큰 (@BotFather 에서 발급)
export TG_BOT_TOKEN="000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# 수신자 chat_id 목록 (공백으로 구분)
# bash는 export로 배열을 전달 못 하므로 문자열로 두고 필요 시 read -a 사용
export TG_CHAT_IDS_STR="123456789 987654321"

# 프로젝트 경로
export PROJECT_DIR="${PROJECT_DIR:-$HOME/Repositories/Claude/LMJAgent}"
